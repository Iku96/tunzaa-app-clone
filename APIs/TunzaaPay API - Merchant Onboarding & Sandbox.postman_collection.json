                },
                "url": {
                  "raw": "{{base_url}}/payments/transactions/{{transaction_id}}/callback/",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "payments",
                    "transactions",
                    "{{transaction_id}}",
                    "callback",
                    ""
                  ]
                },
                "description": "Manually trigger a sandbox callback for testing.\n\n**Scenarios:**\n- `success` - Transaction completed\n- `failed` - Transaction failed\n- `timeout` - Transaction timeout\n- `insufficient_funds` - Insufficient balance\n- `invalid_msisdn` - Invalid phone number\n- `network_error` - Network error\n\n**Note:** Only works for sandbox transactions (is_sandbox=True)."
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "Text",
              "header": [],
