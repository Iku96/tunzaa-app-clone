        {
          "name": "1.5 Google OAuth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"authorization_code\": \"4/0AeanS0Z...\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "accounts",
                "auth",
                "google"
              ]
            },
            "description": "Authenticate with Google OAuth.\n\n**Flow:**\n1. Frontend redirects user to Google consent screen\n2. Google returns authorization code\n3. Send code to this endpoint\n4. Backend exchanges code for user info\n5. Returns JWT tokens\n\n**Required Settings:**\n- GOOGLE_CLIENT_ID\n- GOOGLE_CLIENT_SECRET\n- GOOGLE_REDIRECT_URI"
          },
          "response": []
        },
        {
          "name": "1.6 Apple Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"authorization_code\": \"c...\",\n    \"id_token\": \"eyJraWQiOiJ...\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/auth/apple",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "accounts",
                "auth",
                "apple"
              ]
            },
            "description": "Authenticate with Apple Sign In.\n\n**Flow:**\n1. Frontend uses Apple Sign In JS framework\n2. Apple returns authorization code and ID token\n3. Send both to this endpoint\n4. Backend validates and creates/links user\n5. Returns JWT tokens"
          },
          "response": []
        },
        {
          "name": "1.7 Get Token (API Key Auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"api_key\": \"SB_ABCDEF123456...\",\n    \"secret_key\": \"xyz123...\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/request/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "accounts",
                "request",
                "token"
              ]
            },
            "description": "Get JWT token using API key and secret key (for API clients).\n\n**Note:** Sandbox keys start with `SB_`, Live keys start with `LV_`."
          },
          "response": []
        }
