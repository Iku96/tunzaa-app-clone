    {
      "name": "6. Payments",
      "item": [
        {
          "name": "6.1 Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Environment",
                "value": "sandbox",
                "description": "Required: 'sandbox' or 'live'"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 5000.00,\n    \"customer_msisdn\": \"255754540681\",\n    \"reference\": \"ORDER-12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/initiate-payment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments",
                "initiate-payment"
              ]
            },
            "description": "Initiate a payment request.\n\n**X-Environment Header:**\n- `sandbox` - Test transaction (uses sandbox credentials)\n- `live` - Real transaction (uses live credentials)\n\n**Providers:**\n- `VODACOM` - M-Pesa\n- `AIRTEL` - Airtel Money\n- `TIGO` - Tigo Pesa\n- `AZAMPESA` - Azam Pesa"
          },
          "response": []
        },
        {
