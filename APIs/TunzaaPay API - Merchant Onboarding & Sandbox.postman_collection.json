                "{{transaction_id}}"
              ]
            },
            "description": "Check the status of a transaction."
          },
          "response": []
        },
        {
          "name": "6.3 Trigger Sandbox Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"scenario\": \"timeout\" // success/failed/timeout/insufficient_funds/invalid_msisdn/network_error\n}"
            },
            "url": {
              "raw": "{{base_url}}/payments/transactions/{{transaction_id}}/callback/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments",
                "transactions",
                "{{transaction_id}}",
                "callback",
                ""
              ]
            },
            "description": "Manually trigger a sandbox callback for testing.\n\n**Scenarios:**\n- `success` - Transaction completed\n- `failed` - Transaction failed\n- `timeout` - Transaction timeout\n- `insufficient_funds` - Insufficient balance\n- `invalid_msisdn` - Invalid phone number\n- `network_error` - Network error\n\n**Note:** Only works for sandbox transactions (is_sandbox=True)."
          },
          "response": [
            {
              "name": "Success Response",
